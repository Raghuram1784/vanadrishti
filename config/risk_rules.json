{
  "version": "1.0",
  "description": "Deterministic, explainable security risk scoring rules for VanaDrishti wildlife monitoring.",
  "scoring_weights": {
    "person": {
      "base_detection": 25,
      "zone_core": 30,
      "zone_restricted": 20,
      "outside_allowed_hours": 20,
      "patrol_unauthorized": 20,
      "repeated_activity": 10
    },
    "vehicle": {
      "base_detection": 20,
      "zone_core": 30,
      "zone_restricted": 20,
      "outside_allowed_hours": 20,
      "patrol_unauthorized": 15,
      "repeated_activity": 10
    },
    "wildlife_context": {
      "recent_high_value_wildlife_nearby": 15,
      "recent_animal_activity_prior": 10
    }
  },
  "risk_levels": {
